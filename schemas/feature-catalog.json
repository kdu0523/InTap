    "code.cyclomatic_complexity": {
      "definition_version": "1.0.0",
      "unit": "count",
      "description": "Per matched callable. Delta = after - before; absolute values are at least one.",
      "value_schema": {
        "type": "integer"
      },
      "allowed_phases": [
        "before",
        "after",
        "delta"
      ],
      "allowed_methods": [
        "static_analysis",
        "deterministic_derivation"
      ],
      "implementation_status": "planned",
      "absolute_minimum": 1
    },
